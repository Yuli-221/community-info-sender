<!DOCTYPE html>
<html lang="zh-TW">
<head>
<meta charset="UTF-8">
<title>合併排序</title>
<style>
body{text-align:center;}
#array{display:flex;height:300px;align-items:flex-end;}
.bar{width:10px;margin:1px;background:purple;}
.active{background:red;}
</style>
</head>

<body>
<h1>合併排序</h1>
<button onclick="generate()">重新產生</button>
<button onclick="mergeSort(0,arr.length-1)">開始</button>
<div id="array"></div>

<script>
let arr=[],delay=30;
function sleep(ms){return new Promise(r=>setTimeout(r,ms));}

function generate(){
    arr=[]; array.innerHTML="";
    for(let i=0;i<50;i++){
        let v=Math.random()*200+10;
        arr.push(v);
        let d=document.createElement("div");
        d.className="bar";
        d.style.height=v+"px";
        array.appendChild(d);
    }
}

function update(a=[]){
    let bars=document.querySelectorAll(".bar");
    bars.forEach((b,i)=>{
        b.style.height=arr[i]+"px";
        b.classList.toggle("active",a.includes(i));
    });
}

async function mergeSort(l,r){
    if(l>=r)return;
    let m=Math.floor((l+r)/2);
    await mergeSort(l,m);
    await mergeSort(m+1,r);
    await merge(l,m,r);
}

async function merge(l,m,r){
    let temp=[],i=l,j=m+1;
    while(i<=m && j<=r){
        temp.push(arr[i]<arr[j]?arr[i++]:arr[j++]);
    }
    while(i<=m) temp.push(arr[i++]);
    while(j<=r) temp.push(arr[j++]);

    for(let k=l;k<=r;k++){
        arr[k]=temp[k-l];
        update([k]);
        await sleep(delay);
    }
}
generate();
</script>
</body>
</html>
