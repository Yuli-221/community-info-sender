<!DOCTYPE html>
<html lang="zh-TW">
<head>
<meta charset="UTF-8">
<title>選擇排序</title>
<style>
body{text-align:center;}
#array{display:flex;height:300px;align-items:flex-end;}
.bar{width:10px;margin:1px;background:orange;}
.active{background:red;}
</style>
</head>

<body>
<h1>選擇排序</h1>
<button onclick="generate()">重新產生</button>
<button onclick="selectionSort()">開始</button>
<div id="array"></div>

<script>
let arr=[],delay=30;
function sleep(ms){return new Promise(r=>setTimeout(r,ms));}

function generate(){
    arr=[]; array.innerHTML="";
    for(let i=0;i<50;i++){
        let v=Math.random()*200+10;
        arr.push(v);
        let d=document.createElement("div");
        d.className="bar";
        d.style.height=v+"px";
        array.appendChild(d);
    }
}

function update(a=[]){
    let bars=document.querySelectorAll(".bar");
    bars.forEach((b,i)=>{
        b.style.height=arr[i]+"px";
        b.classList.toggle("active",a.includes(i));
    });
}

async function selectionSort(){
    for(let i=0;i<arr.length;i++){
        let min=i;
        for(let j=i+1;j<arr.length;j++){
            update([min,j]);
            await sleep(delay);
            if(arr[j]<arr[min]) min=j;
        }
        [arr[i],arr[min]]=[arr[min],arr[i]];
    }
}
generate();
</script>
</body>
</html>
