<!DOCTYPE html>
<html lang="zh-TW">
<head>
<meta charset="UTF-8">
<title>氣泡排序</title>
<style>
body { text-align:center; }
#array { display:flex; align-items:flex-end; height:300px; }
.bar { width:10px; margin:1px; background:blue; }
.active { background:red; }
</style>
</head>

<body>
<h1>氣泡排序</h1>
<button onclick="generate()">重新產生</button>
<button onclick="bubbleSort()">開始</button>
<div id="array"></div>

<script>
let arr=[], delay=30;

function sleep(ms){ return new Promise(r=>setTimeout(r,ms)); }

function generate(){
    arr=[];
    array.innerHTML="";
    for(let i=0;i<50;i++){
        let v=Math.floor(Math.random()*200)+10;
        arr.push(v);
        let d=document.createElement("div");
        d.className="bar";
        d.style.height=v+"px";
        array.appendChild(d);
    }
}

function update(a=[]){
    let bars=document.querySelectorAll(".bar");
    bars.forEach((b,i)=>{
        b.style.height=arr[i]+"px";
        b.classList.toggle("active", a.includes(i));
    });
}

async function bubbleSort(){
    for(let i=0;i<arr.length;i++){
        for(let j=0;j<arr.length-i-1;j++){
            update([j,j+1]);
            await sleep(delay);
            if(arr[j]>arr[j+1]){
                [arr[j],arr[j+1]]=[arr[j+1],arr[j]];
            }
        }
    }
}
generate();
</script>
</body>
</html>
