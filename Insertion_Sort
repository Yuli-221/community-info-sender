<!DOCTYPE html>
<html lang="zh-TW">
<head>
<meta charset="UTF-8">
<title>插入排序</title>
<style>
body{text-align:center;}
#array{display:flex;height:300px;align-items:flex-end;}
.bar{width:10px;margin:1px;background:green;}
.active{background:red;}
</style>
</head>

<body>
<h1>插入排序</h1>
<button onclick="generate()">重新產生</button>
<button onclick="insertionSort()">開始</button>
<div id="array"></div>

<script>
let arr=[],delay=30;
function sleep(ms){return new Promise(r=>setTimeout(r,ms));}

function generate(){
    arr=[]; array.innerHTML="";
    for(let i=0;i<50;i++){
        let v=Math.random()*200+10;
        arr.push(v);
        let d=document.createElement("div");
        d.className="bar";
        d.style.height=v+"px";
        array.appendChild(d);
    }
}

function update(a=[]){
    let bars=document.querySelectorAll(".bar");
    bars.forEach((b,i)=>{
        b.style.height=arr[i]+"px";
        b.classList.toggle("active",a.includes(i));
    });
}

async function insertionSort(){
    for(let i=1;i<arr.length;i++){
        let key=arr[i], j=i-1;
        while(j>=0 && arr[j]>key){
            arr[j+1]=arr[j];
            j--;
            update([j,j+1]);
            await sleep(delay);
        }
        arr[j+1]=key;
    }
}
generate();
</script>
</body>
</html>
