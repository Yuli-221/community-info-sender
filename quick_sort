<!DOCTYPE html>
<html lang="zh-TW">
<head>
<meta charset="UTF-8">
<title>快速排序</title>
<style>
body{text-align:center;}
#array{display:flex;height:300px;align-items:flex-end;}
.bar{width:10px;margin:1px;background:black;}
.active{background:red;}
</style>
</head>

<body>
<h1>快速排序</h1>
<button onclick="generate()">重新產生</button>
<button onclick="quickSort(0,arr.length-1)">開始</button>
<div id="array"></div>

<script>
let arr=[],delay=30;
function sleep(ms){return new Promise(r=>setTimeout(r,ms));}

function generate(){
    arr=[]; array.innerHTML="";
    for(let i=0;i<50;i++){
        let v=Math.random()*200+10;
        arr.push(v);
        let d=document.createElement("div");
        d.className="bar";
        d.style.height=v+"px";
        array.appendChild(d);
    }
}

function update(a=[]){
    let bars=document.querySelectorAll(".bar");
    bars.forEach((b,i)=>{
        b.style.height=arr[i]+"px";
        b.classList.toggle("active",a.includes(i));
    });
}

async function quickSort(l,r){
    if(l<r){
        let pi=await partition(l,r);
        await quickSort(l,pi-1);
        await quickSort(pi+1,r);
    }
}

async function partition(l,r){
    let pivot=arr[r],i=l-1;
    for(let j=l;j<r;j++){
        update([j,r]);
        await sleep(delay);
        if(arr[j]<pivot){
            i++;
            [arr[i],arr[j]]=[arr[j],arr[i]];
        }
    }
    [arr[i+1],arr[r]]=[arr[r],arr[i+1]];
    return i+1;
}
generate();
</script>
</body>
</html>
